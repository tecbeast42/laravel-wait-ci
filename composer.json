{
    "name": "tecbeast42/laravel-wait-ci",
    "description": "Wait for your storage and database to be reachable in ci",
    "keywords": [
        "tecbeast42",
        "laravel",
        "laravel-wait-ci"
    ],
    "homepage": "https://github.com/tecbeast42/laravel-wait-ci",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Kriebisch",
            "email": "tobias.kriebisch@tecbeast.gmbh",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.14",
        "illuminate/contracts": "^9|^10|^11|^12|^13"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "larastan/larastan": "^2.11.2|^3.10",
        "orchestra/testbench": "^7|^8|^9|^10|^11",
        "pestphp/pest": "^1.23|^2.36|^3.8|^4.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tecbeast42\\LaravelWaitCi\\": "src",
            "Tecbeast42\\LaravelWaitCi\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tecbeast42\\LaravelWaitCi\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tecbeast42\\LaravelWaitCi\\LaravelWaitCiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
